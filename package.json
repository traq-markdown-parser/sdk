{
  "name": "@traq-markdown-parser/ts",
  "version": "0.1.0",
  "private": true,
  "description": "Composable Rust Markdown parser with Go and TypeScript bindings.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nodes": {
      "types": "./dist/generated/nodes.d.ts",
      "import": "./dist/generated/nodes.js"
    },
    "./commonmark/nodes": {
      "types": "./dist/generated/commonmark.d.ts",
      "import": "./dist/generated/commonmark.js"
    },
    "./generic/nodes": {
      "types": "./dist/generated/generic.d.ts",
      "import": "./dist/generated/generic.js"
    },
    "./trap/nodes": {
      "types": "./dist/generated/trap.d.ts",
      "import": "./dist/generated/trap.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./contract.json": "./dist/contract.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/validation.js",
    "dist/validation.d.ts",
    "dist/generated",
    "dist/parser.wasm",
    "dist/contract.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test typescript/tests/*.test.mjs",
    "typecheck": "tsc -p typescript/tsconfig.json --noEmit && tsc -p examples/typescript/tsconfig.json",
    "test:rust": "cargo test --workspace --all-features",
    "test:go": "go -C go test -count=1 ./...",
    "example:rust": "cargo run -p traq-markdown-example",
    "example:go": "go -C examples/go run .",
    "example:ts": "node examples/typescript/main.mts",
    "examples": "npm run example:rust && npm run example:go && npm run example:ts",
    "check:package": "node scripts/package-check.mjs",
    "check:architecture": "node scripts/check-js-boundaries.mjs",
    "build:ts": "tsc -p typescript/tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traq-markdown-parser/sdk.git"
  },
  "author": "traP (https://github.com/traPtitech)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/traq-markdown-parser/sdk/issues"
  },
  "homepage": "https://github.com/traq-markdown-parser/sdk#readme",
  "sideEffects": false,
  "dependencies": {},
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "6.0.3"
  },
  "type": "module"
}
